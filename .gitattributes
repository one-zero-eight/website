# Replace CRLF with LF on Windows
* text=auto eol=lf

# Do not touch binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
