{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "webworker"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/service-worker"],
  "exclude": ["src/service-worker/page"]
}
